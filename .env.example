# Copy to .env.local and fill in. Real values never live in the repo.

# --- API (apps/api) ---
DATABASE_URL=postgresql://user:pass@host:5432/db
LUMA_AGENTS_API_KEY=luma-api-xxxxx

# Review email (Resend). REVIEWER_EMAIL = Ellie's inbox (single reviewer in v1).
RESEND_API_KEY=re_xxxxx
REVIEW_FROM_EMAIL=onboarding@resend.dev
REVIEWER_EMAIL=ellie@example.com

# Railway Bucket (S3-compatible). Map from the Bucket service's variables:
# BUCKET -> BUCKET_NAME (NOT RAILWAY_BUCKET_NAME, which is only the display name)
BUCKET_ENDPOINT=https://bucket.railway.app
BUCKET_NAME=xxxxx
BUCKET_ACCESS_KEY_ID=xxxxx
BUCKET_SECRET_ACCESS_KEY=xxxxx
BUCKET_REGION=auto

# Operator auth. Generate hash: pnpm hash-password  |  secret: openssl rand -base64 32
OPERATOR_EMAIL=maya@example.com
OPERATOR_PASSWORD_HASH=$argon2id$...
SESSION_SECRET=xxxxx

WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001
PORT=3001

# --- Web (apps/web) ---
API_URL=http://localhost:3001
